# Copy to .env.production on the host only. Generate each secret independently.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
DATABASE_URL=postgres://marketplace:replace-with-url-safe-random-password@postgres:5432/marketplace
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-independent-random-secret-at-least-32-characters
COOKIE_SECRET=replace-with-independent-random-secret-at-least-32-characters
HASH_OTP_SECRET=replace-with-independent-random-secret-at-least-32-characters
STORE_CORS=https://your-hfg-frontend.example
ADMIN_CORS=https://partners.hashforgamers.com
AUTH_CORS=https://your-hfg-frontend.example,https://partners.hashforgamers.com
# Initial administrator only. Remove these two values after first successful deployment.
HASH_ADMIN_EMAIL=admin@your-company.example
HASH_ADMIN_PASSWORD=replace-with-strong-initial-admin-password
